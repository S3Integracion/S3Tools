<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishUrlHistory>C:\Releases\S3Tools\|C:\Resources\S3Tools\|C:\Resources\|publish\</PublishUrlHistory>
    <InstallUrlHistory>https://s3integracion.github.io/S3Tools/.setup.exe/|https://s3integracion.github.io/S3Tools/</InstallUrlHistory>
    <SupportUrlHistory>https://github.com/S3Integracion/S3Tools</SupportUrlHistory>
    <UpdateUrlHistory>http://s3integracion.github.io/S3Tools/</UpdateUrlHistory>
    <BootstrapperUrlHistory />
    <ErrorReportUrlHistory />
    <FallbackCulture>en-US</FallbackCulture>
    <VerifyUploadedFiles>false</VerifyUploadedFiles>
  </PropertyGroup>
  <PropertyGroup>
    <EnableSecurityDebugging>false</EnableSecurityDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="AsinBatcherControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="AsinNoReportControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="CategoriasControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="FileNameConfigDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Form1.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="FormatoControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="SitemapControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
  </ItemGroup>
</Project>